import bpy
import bmesh
from mathutils import Vector

def set_origin_to_bottom(obj):
    # Make the object active and in object mode
    bpy.context.view_layer.objects.active = obj
    bpy.ops.object.mode_set(mode='OBJECT')

    # Get the bounding box corners in world space
    local_bbox_corners = [Vector(corner) for corner in obj.bound_box]
    world_bbox_corners = [obj.matrix_world @ corner for corner in local_bbox_corners]

    # Find bottom center (min z)
    min_z = min(corner.z for corner in world_bbox_corners)
    bottom_verts = [v for v in world_bbox_corners if abs(v.z - min_z) < 1e-4]
    avg_bottom = sum((v for v in bottom_verts), Vector()) / len(bottom_verts)

    # Convert world position back to local space
    local_bottom = obj.matrix_world.inverted() @ avg_bottom

    # Apply origin shift
    for vert in obj.data.vertices:
        vert.co -= local_bottom
    obj.location += obj.matrix_world.to_quaternion() @ local_bottom

def align_selected_origins_to_bottom():
    selected_objects = bpy.context.selected_objects

    for obj in selected_objects:
        if obj.type == 'MESH':
            set_origin_to_bottom(obj)

align_selected_origins_to_bottom()
